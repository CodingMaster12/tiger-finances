# Placeholders only. Copy to .env.local and fill in. Never commit real values.
# Full step-by-step instructions: docs/SUPABASE_SETUP.md

# Public (safe in the browser): Supabase Project URL and Publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for account deletion.
SUPABASE_SECRET_KEY=

# Public URL of this app, used in email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEC EDGAR (server only). The SEC requires every request to say who is asking: an app name plus a contact email or website.
# Format: your app name + an email, e.g. Tiger Finances contact@example.com
# NO web link: the SEC refuses user-agent lines that contain one (verified 2026-11-09). Required in production. No key or sign-up needed.
SEC_USER_AGENT=
# The data-sync job (npm run sec:sync, or the GitHub workflow) also needs NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SECRET_KEY from above.
# Development only (ignored in production): point SEC requests at the local fixture server, `npm run dev:sec-fixtures`.
# SEC_DATA_ORIGIN=http://localhost:4010
