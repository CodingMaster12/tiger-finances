 "narrative": {
  "northStar": "The Illuminated Ledger",
  "overview": "Financial records, lit from within. A dark ink-violet ground carries gold as the light source with quiet violet, cyan and emerald accents. Precise and trustworthy first, eye-catching second: the home page gets motion and atmosphere, data pages stay calm and dense. Dial setting 0.6 on the owner's scale (0 = first gold-on-black pass, 1 = full bright pass).",
  "keyCharacteristics": [
   "Dark only",
   "Gold-led with colour as accents",
   "Motion on the home page only, soft and slow, fully stopped for reduced motion",
   "Data pages calm: no glow, no gradients behind numbers"
  ],
  "rules": [
   {
    "name": "The Gold Is Light Rule",
    "body": "Gold marks what is active or primary. If everything is gold, nothing is.",
    "section": "colors"
   },
   {
    "name": "The Never-In-Text Rule",
    "body": "Gradients fill backgrounds, buttons and banners; never text.",
    "section": "colors"
   },
   {
    "name": "The One Glow Rule",
    "body": "Glow belongs to the primary action and the home scene only.",
    "section": "elevation"
   },
   {
    "name": "The No-Kicker Rule",
    "body": "No small label above a heading.",
    "section": "typography"
   }
  ],
  "dos": [
   "Do keep the product at the 0.6 setting",
   "Do pair every up/down or status colour with an arrow, sign or word",
   "Do keep numbers on data pages, with their source",
   "Do stop all motion under prefers-reduced-motion"
  ],
  "donts": [
   "Don't use gradient text, decorative blur or coloured card side-borders",
   "Don't add pink gradients or neon glows (the rejected 1.0 pass)",
   "Don't put numbers or chart-like graphics on the home page",
   "Don't add a light theme without being asked"
  ]
 }
}